# Copy to .env and fill in real values. All secrets are optional locally:
# the app degrades to deterministic stubs when they are absent.

# LLM provider (planner / critic / writer agents)
OPENAI_API_KEY=

# Web search provider (Tavily-compatible API)
SEARCH_API_KEY=
SEARCH_API_BASE_URL=https://api.tavily.com

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agentic-web-researcher

# Auth (JWT) — required in production, optional locally
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_TTL_MINUTES=60

# Operational limits
MAX_SUB_QUESTIONS=6
MAX_CRITIC_ROUNDS=2
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_TIMEOUT_SECONDS=15.0
SCRAPE_MAX_BYTES=2000000
DATABASE_URL=sqlite:///./data/jobs.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
